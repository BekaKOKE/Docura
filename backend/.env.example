# Copy to .env for local development. Every value has a dev default, so the file is optional.

# memory = in-memory repositories (M3); sql = SQLAlchemy repositories (M4)
STORAGE=memory

# Any SQLAlchemy URL; SQLite for development, PostgreSQL later. Used when STORAGE=sql.
DATABASE_URL=sqlite:///./docura.db

# Signs the bearer tokens (HS256). Change it outside development.
JWT_SECRET=dev-secret-change-me

# The address the client's phone opens for a share link. Use http://<your LAN IP>:5173 to test on a phone.
PUBLIC_BASE_URL=http://localhost:5173

# Allowed browser origins, comma separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
