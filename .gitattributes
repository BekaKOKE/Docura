# Text files are stored and checked out with LF on every OS, so a fresh clone on Windows has a clean `git status`.
* text=auto eol=lf

# Binary files: never converted, never diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.db binary
*.sqlite binary
